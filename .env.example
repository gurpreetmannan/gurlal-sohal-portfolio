# =============================================================================
# Gurlal Sohal Raider Portfolio - Vercel Environment Variables Reference
# =============================================================================
# The current production build is a pure, ultra-fast static HTML5 application 
# that deploys on Vercel with ZERO required environment variables.
# 
# The variables below are optional configuration flags you can define in your 
# Vercel Project Dashboard (Settings > Environment Variables) if you choose 
# to bind custom domains, analytics, or future backend services (Supabase/Firebase).
# =============================================================================

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.gurlalsohal.sbs
NEXT_PUBLIC_WHATSAPP_PHONE=+91 98490 04200
NEXT_PUBLIC_CONTACT_EMAIL=contact@gurlalsohal.com

# Optional Analytics & Monitoring
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Cloud Database Adapter (Ready for Supabase when upgrading from localStorage)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
